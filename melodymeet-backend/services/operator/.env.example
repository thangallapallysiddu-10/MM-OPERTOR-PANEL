# Environment: production, development, or testing
NODE_ENV=development


DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=bharath
DB_NAME=melodymeet_operator

# Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:8081,http://localhost:3000

# JWT Secrets - Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_random_hex_string_min_64_chars_here_generated_with_crypto
JWT_REFRESH_SECRET=your_another_random_hex_string_min_64_chars_here_generated_with_crypto
AUTH_ENCRYPTION_KEY=your_encryption_key_32_bytes_hex_string_here
MOBILE_HASH_SECRET=your_mobile_hash_secret_min_32_chars_here
DEVICE_HASH_SECRET=your_device_hash_secret_min_32_chars_here

# Session Configuration
REFRESH_TOKEN_DAYS=30
SESSION_TIMEOUT_MINUTES=30

# File Upload Configuration
MAX_UPLOAD_SIZE=104857600
JSON_BODY_LIMIT=2mb

# Logging
LOG_LEVEL=info

# 2FA/Biometric Configuration
BIOMETRIC_TIMEOUT_MS=300000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MS=1000
